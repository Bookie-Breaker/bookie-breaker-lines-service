# lines-service environment variables
PORT=8001
LOG_LEVEL=info
DATABASE_URL=postgres://bookiebreaker:localdev@localhost:5432/bookiebreaker?search_path=lines,public
REDIS_URL=redis://localhost:6379
ODDS_API_KEY=your-odds-api-key-here
# 300s ~= 288 requests/day per sport; the free tier is 500/month, so use 900+ on it
ODDS_API_POLL_INTERVAL=300
# Comma-separated Odds API sport keys to poll
ODDS_API_SPORTS=basketball_nba
# Player-prop ingestion (Phase 7 Wave 3). Props require one Odds API request
# PER EVENT, so quota gating matters: only sports on this allow-list are
# polled, only events starting within the commence window are fetched, and
# each cycle fetches at most PROP_MAX_EVENTS_PER_CYCLE events. Set
# PROP_SPORTS= (explicitly empty) to disable prop ingestion. NBA/NFL prop
# markets are configured in code but dormant until added here.
PROP_SPORTS=soccer_fifa_world_cup,soccer_epl,baseball_mlb
# Seconds between prop cycles. 1800s with 3 sports and a cap of 10 events is
# up to ~1440 requests/day worst case; widen the interval on tight quotas.
PROP_POLL_INTERVAL=1800
# Only fetch props for events commencing within this many hours
PROP_COMMENCE_WINDOW_HOURS=48
# Hard cap on per-event odds requests per sport per cycle (logged when hit)
PROP_MAX_EVENTS_PER_CYCLE=10
# SharpAPI live-line SSE stream (ADR-007 amended; Phase 7 Wave 2 stub).
# Leave SHARP_API_URL unset to disable the live consumer; REST polling covers
# ingestion either way. SHARP_API_KEY is optional (empty for the stub).
# SHARP_API_URL=http://localhost:8010
# SHARP_API_KEY=
# Consecutive stream failures before logging that REST polling is covering
SHARP_API_FAILURE_THRESHOLD=5
